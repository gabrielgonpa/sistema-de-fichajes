generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empleado {
  id          Int        @id @default(autoincrement())
  nombre      String
  apellido    String
  codigo      String     @unique
  fichajes    Fichaje[]
}

model Fichaje {
  id          Int       @id @default(autoincrement())
  tipo        TipoFichaje
  fechaHora   DateTime   @default(now())
  empleadoId  Int
  empleado    Empleado   @relation(fields: [empleadoId], references: [id])
}

enum TipoFichaje {
  ENTRADA
  SALIDA
  PAUSA
  REANUDAR
}
